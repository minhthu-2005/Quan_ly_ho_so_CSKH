<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- TREE VIEW -->
    <record id="view_crm_interaction_history_tree"
            model="ir.ui.view">

        <field name="name">
            crm.interaction.history.tree
        </field>

        <field name="model">
            crm.interaction.history
        </field>

        <field name="arch" type="xml">

            <tree>

                <field name="name"/>
                <field name="customer_id"/>
                <field name="interaction_type"/>
                <field name="interaction_date"/>
                <field name="user_id"/>
                <field name="state"/>

            </tree>

        </field>

    </record>

    <!-- FORM VIEW -->
    <record id="view_crm_interaction_history_form"
            model="ir.ui.view">

        <field name="name">
            crm.interaction.history.form
        </field>

        <field name="model">
            crm.interaction.history
        </field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button name="action_done"
                            type="object"
                            string="Hoàn thành"
                            class="btn-primary"/>

                    <button name="action_cancel"
                            type="object"
                            string="Hủy"
                            class="btn-danger"/>

                    <field name="state"
                           widget="statusbar"/>

                </header>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="lead_id"/>
                        <field name="interaction_type"/>
                        <field name="interaction_date"/>
                        <field name="user_id"/>

                    </group>

                    <notebook>

                        <page string="Nội dung">

                            <group>

                                <field name="content"/>
                                <field name="result"/>
                                <field name="customer_need"/>
                                <field name="next_action"/>
                                <field name="followup_deadline"/>

                            </group>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>

</odoo>